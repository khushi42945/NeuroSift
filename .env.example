# Copy to .env. Use unique random secrets before exposing any deployment.
ENVIRONMENT=development
SECRET_KEY=replace-with-at-least-32-random-characters
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable; changing it makes existing encrypted journal entries unreadable.
FIELD_ENCRYPTION_KEY=
POSTGRES_PASSWORD=mindpulse-local-only
DATABASE_URL=postgresql+psycopg://mindpulse:mindpulse-local-only@localhost:5432/mindpulse
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PROXY_URL=http://localhost:8000
AUTO_CREATE_SCHEMA=false

# Optional Google OAuth. Register the callback URL with Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Optional Hugging Face text-classification model. Requires a compatible PyTorch install.
HF_EMOTION_MODEL=

# Optional OpenAI-compatible chat-completions endpoint. Leave blank for local rule-based replies.
# When enabled, chat text is sent to this configured provider; see the chat privacy notice.
CONVERSATION_MODEL_URL=
CONVERSATION_MODEL_API_KEY=
CONVERSATION_MODEL_NAME=